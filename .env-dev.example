# Copy to .env-dev (gitignored) and set your name: lucas, andre or youcef.
# Selects your environment for Terraform, db/migrate.py and scripts/deploy-*.sh.
# Load it with your credentials: set -a; source .env-aws; source .env-dev; set +a
# For prod, use TF_WORKSPACE=default (Terraform also needs -var confirm_prod=true).
TF_WORKSPACE=yourname
