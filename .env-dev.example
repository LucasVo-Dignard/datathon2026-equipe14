# Copy to .env-dev (gitignored) and set your name: lucas, andre or youcef.
# Selects your environment for Terraform, db/migrate.py and scripts/deploy-*.sh.
# Load it with your credentials: set -a; source .env-aws; source .env-dev; set +a
# For prod, use TF_WORKSPACE=default (Terraform also needs -var confirm_prod=true).
TF_WORKSPACE=yourname

# `npm run dev` also loads this file (after .env-aws): optional app settings,
# uncomment to use them locally (see README.md).
# DATABASE_URL=postgres://bncd_admin:localdev@127.0.0.1:5432/marketdata
# AWS_REGION=us-east-1
# RESEARCH_HARNESS_ARN=
# RESEARCH_REVIEWER_ARN=
# RESEARCH_GATEWAY_URL=
# RESEARCH_KB_BUCKET=
# RESEARCH_KB_ID=
# RESEARCH_KB_DATA_SOURCE_ID=
# ALERTS_SENDER=
