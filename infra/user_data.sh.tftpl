#!/bin/bash
# Runs once on first boot: installs Docker and runs the web app image from ECR
# on port 80. The app code is NOT embedded here (no 16 KB limit): it ships as
# the image built by ../scripts/deploy-app.sh.
#
# Redeploying the app does not recreate the instance: deploy-app.sh pushes a new
# image and restarts the service, which pulls it again (ExecStartPre).
set -euxo pipefail

dnf update -y
dnf install -y docker
systemctl enable --now docker

# Prototype JSON data (users, sessions, chats), kept across app redeploys.
# uid 1000 = the "node" user inside the image.
install -d -o 1000 -g 1000 -m 700 /var/lib/chatbot

# Extra environment for the container (e.g. DATABASE_URL later). Not in Git.
install -m 600 /dev/null /etc/chatbot.env

cat > /etc/systemd/system/chatbot.service <<'UNIT'
[Unit]
Description=Web app container (${image})
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
# Keep retrying forever: the image may be pushed after the instance boots.
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=15
ExecStartPre=-/usr/bin/docker rm -f chatbot
ExecStartPre=/bin/sh -c 'aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${registry}'
ExecStartPre=/usr/bin/docker pull ${image}
ExecStart=/usr/bin/docker run --rm --name chatbot -p 80:3000 -v /var/lib/chatbot:/data --env-file /etc/chatbot.env ${image}
ExecStop=/usr/bin/docker stop chatbot

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now chatbot
