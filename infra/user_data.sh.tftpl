#!/bin/bash
# Runs once on first boot: installs Node.js and runs the chatbot (../app) on port 80.
# Rendered by Terraform (templatefile): the app files are embedded gzip+base64.
set -euxo pipefail

dnf update -y
dnf install -y nodejs22 || dnf install -y nodejs
NODE_BIN="$(command -v node || command -v node-22)"

APP_DIR=/opt/chatbot
rm -rf "$APP_DIR"
%{ for f in files ~}
mkdir -p "$(dirname "$APP_DIR/${f.path}")"
echo '${f.content}' | base64 -d | gunzip > "$APP_DIR/${f.path}"
%{ endfor ~}
chmod -R a+rX "$APP_DIR"

cat > /etc/systemd/system/chatbot.service <<UNIT
[Unit]
Description=Chatbot prototype
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=$NODE_BIN $APP_DIR/server.js
Environment=PORT=80
Environment=DATA_FILE=/var/lib/chatbot/db.json
DynamicUser=yes
StateDirectory=chatbot
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now chatbot
