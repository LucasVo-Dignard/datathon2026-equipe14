# Example overrides. Don't copy this to terraform.tfvars: Terraform loads that
# file in every workspace, prod included (see ../ENVIRONMENTS.md). Pass values
# with -var, or copy to <name>.tfvars (gitignored) and pass -var-file=<name>.tfvars.

# In dev environments the IP of the machine running terraform is allowed
# automatically (allow_my_ip defaults to true there, false in prod).
# allow_my_ip = true

# Default: the Polytechnique network only. Add teammates' IPs here (keep it in
# the list). Find yours with: curl -s https://checkip.amazonaws.com
# allowed_cidrs = ["132.207.0.0/16", "203.0.113.4/32", "198.51.100.7/32"]

# Open SSH to the allowed IPs only while you need it.
# enable_ssh = true

# Stop the instance when you're not using it.
# instance_running = false

# instance_type = "t3.micro"

# Pin an app image (git SHA) to roll back. Changing it recreates the instance.
# app_image_tag = "latest"

# Price alerts by email (SES). Changing either recreates the instance.
# alerts_enabled      = true
# alerts_sender_email = "someone@example.com"
