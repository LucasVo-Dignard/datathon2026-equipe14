variable "project_name" {
  description = "Prefix used for resource names and tags. Must match ../infra, whose VPC and security group are found by name."
  type        = string
  default     = "datathon2026-equipe14"
}

variable "region" {
  description = "AWS region. Leave null to use AWS_DEFAULT_REGION from the environment."
  type        = string
  default     = null
}

variable "engine" {
  description = "Database engine: postgres or mysql."
  type        = string
  default     = "postgres"

  validation {
    condition     = contains(["postgres", "mysql"], var.engine)
    error_message = "The engine must be postgres or mysql."
  }
}

variable "engine_version" {
  description = "Major engine version. Leave null for the default of the chosen engine (postgres 17, mysql 8.4)."
  type        = string
  default     = null
}

variable "instance_class" {
  description = "RDS instance class. db.t4g.small (2 vCPU burstable, 2 GiB RAM) is a modest default; avoid anything bigger without a reason."
  type        = string
  default     = "db.t4g.small"
}

variable "allocated_storage" {
  description = "Storage in GiB (20 is the gp3 minimum)."
  type        = number
  default     = 20
}

variable "db_name" {
  description = "Name of the database created at launch."
  type        = string
  default     = "marketdata"
}

variable "master_username" {
  description = "Master user name. Its password is generated by RDS and stored in Secrets Manager, never in Terraform or Git."
  type        = string
  default     = "bncd_admin"
}

variable "backup_retention_days" {
  description = "Days of automated backups (0 disables them)."
  type        = number
  default     = 1
}

variable "private_subnet_cidrs" {
  description = "Two CIDRs inside the ../infra VPC (10.0.0.0/16) for the private DB subnets, one per availability zone. Must not overlap the public subnet 10.0.1.0/24."
  type        = list(string)
  default     = ["10.0.101.0/24", "10.0.102.0/24"]

  validation {
    condition     = length(var.private_subnet_cidrs) == 2
    error_message = "RDS needs exactly two subnets in different availability zones."
  }
}
